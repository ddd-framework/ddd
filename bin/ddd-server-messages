#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Lists the server messages of a DDD package (build) and merges those of the installed packages (collect) for an
 * application's text export. Plain PHP: boots no kernel and loads no application code.
 */

use DDD\Tools\ServerMessages\ServerMessagesManifest;

if (PHP_VERSION_ID < 80300) {
    fwrite(STDERR, "[ddd-server-messages] PHP 8.3 or newer is required\n");
    exit(1);
}

require_once dirname(__DIR__) . '/tools/ServerMessages/ServerMessagesManifest.php';

exit(ServerMessagesManifest::runFromCommandLine(array_slice($argv, 1), (string)getcwd()));
